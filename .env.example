# =================================================================
# Настройки Telegram бота
# =================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =================================================================
# Настройки Yandex Search API (Поиск по картинке)
# =================================================================
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=b1g2co248mbe7rhlk2ir

# =================================================================
# Настройки OpenAI API (ChatGPT)
# =================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# =================================================================
# Настройки Google Reverse Image Search / Google Lens
# Укажите хотя бы один из ключей (SERPAPI_KEY или GOOGLE_API_KEY)
# =================================================================
# Ключ от SerpAPI (Google Lens API): https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Ключ от Google Cloud Vision API (WEB_DETECTION): https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here
