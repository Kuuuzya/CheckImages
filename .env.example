# =================================================================
# Настройки Telegram бота
# =================================================================
# Токен бота, полученный у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =================================================================
# Настройки Yandex Search API (Поиск по картинке)
# Документация: https://aistudio.yandex.ru/docs/ru/search-api/operations/search-images-by-pic.html
# =================================================================
# API ключ Yandex Cloud / Yandex AI Studio
YANDEX_API_KEY=your_yandex_api_key_here

# ID каталога Yandex Cloud (Folder ID)
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# =================================================================
# Настройки OpenAI API (ChatGPT)
# =================================================================
# Ваш API ключ OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Модель ChatGPT (например: gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini
